-- ================================================================================
-- STATEMENT 1: Update Author Personal Info using Stored Procedure
-- ================================================================================
-- Original Statement:
DECLARE @rowsAffected INT;EXEC @rowsAffected = [dbo].[uspUpdateAuthorPersonalInfo] @BusinessEntityID, @NationalIDNumber, @BirthDate, @MaritalStatus, @Gender;SELECT @rowsAffected;

-- DMS Tool Output:
-- Status: error
-- Error: Metadata model creation failed: {'error': 'Unknown metadata model creation status: RECEIVED'}
-- Timestamp: 2026-02-14T13:38:18.899250

-- Reason for Failure:
-- DMS tool encountered a metadata model creation error

-- Manual Conversion Applied:
-- PostgreSQL doesn't support DECLARE/EXEC pattern with output parameters in the same way as SQL Server
-- The stored procedure call needs to be converted to a PostgreSQL function call using SELECT
-- PostgreSQL function: bobsbookstore_dbo.uspUpdateAuthorPersonalInfo(int, varchar, timestamp, varchar, varchar) returns int
SELECT bobsbookstore_dbo.uspUpdateAuthorPersonalInfo(@BusinessEntityID, @NationalIDNumber, @BirthDate, @MaritalStatus, @Gender);

